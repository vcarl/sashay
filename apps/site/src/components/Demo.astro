---
// A docs example: its source, then a frame it runs in. Vanilla examples export
// `mount(el)`; the React page passes its component as the slot instead.
import { Code } from "@astrojs/starlight/components";
import "@vcarl/sashay/style.css";

const sources = import.meta.glob<string>("../examples/*.{ts,tsx}", { query: "?raw", import: "default", eager: true });
const { name } = Astro.props as { name: string };
const file = Object.keys(sources).find((k) => k.startsWith(`../examples/${name}.`)) as string;
---
<Code code={sources[file]} lang={file.endsWith("x") ? "tsx" : "ts"} title={file.slice(3)} />
<div class="demo not-content" data-demo={Astro.slots.has("default") ? undefined : name}>
  <slot />
</div>

<script>
  const mods = import.meta.glob<{ mount(el: HTMLElement): () => void }>("../examples/*.ts");
  for (const el of document.querySelectorAll<HTMLElement>("[data-demo]")) {
    mods[`../examples/${el.dataset.demo}.ts`]().then((m) => m.mount(el));
  }
</script>
