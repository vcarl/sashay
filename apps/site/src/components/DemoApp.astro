---
// A demo app at full size. Each app in src/demos/<name>/index.ts exports `mount(el, options?)`.
// With `region`, it shows the lines of the app's files marked `#region <region>` (the Guide's
// excerpts); without, the whole index.ts in a collapsible panel.
import { Code } from "@astrojs/starlight/components";
import "@vcarl/sashay/style.css";

const sources = import.meta.glob<string>("../demos/*/*.{ts,css}", { query: "?raw", import: "default", eager: true });
const { name, region, options } = Astro.props as { name: string; region?: string; options?: object };

// Lines whose innermost region is `region`; separate stretches are joined with an ellipsis.
function excerpt(src: string) {
  const chunks: string[][] = [];
  const stack: string[] = [];
  let inChunk = false;
  for (const line of src.split("\n")) {
    const open = line.match(/^\s*(?:\/\/|\/\*)\s*#region\s+(\S+)/);
    if (open) stack.push(open[1]);
    else if (/^\s*(?:\/\/|\/\*)\s*#endregion/.test(line)) stack.pop();
    else if (stack.at(-1) === region) {
      if (!inChunk) chunks.push([]);
      chunks.at(-1)?.push(line);
      inChunk = true;
    }
    if (!stack.includes(region as string)) inChunk = false;
  }
  return chunks
    .map((c) => {
      const indent = Math.min(...c.filter((l) => l.trim()).map((l) => l.search(/\S/)));
      return c.map((l) => l.slice(indent)).join("\n");
    })
    .join("\n\n// …\n\n");
}
const files = region
  ? Object.entries(sources)
      .filter(([k]) => k.startsWith(`../demos/${name}/`))
      .map(([k, src]) => ({ file: k.slice(9), lang: k.split(".").at(-1) as string, code: excerpt(src) }))
      .filter((f) => f.code)
  : [];
---
{files.map((f) => <Code code={f.code} lang={f.lang} title={f.file} />)}
<div class="demo-app not-content" data-demo-app={name} data-options={options && JSON.stringify(options)}></div>
{!region && (
  <details class="demo-source">
    <summary>Source: <code>{name}/index.ts</code></summary>
    <Code code={sources[`../demos/${name}/index.ts`]} lang="ts" />
  </details>
)}

<script>
  const mods = import.meta.glob<{ mount(el: HTMLElement, options?: object): () => void }>("../demos/*/index.ts");
  for (const el of document.querySelectorAll<HTMLElement>("[data-demo-app]")) {
    const options = el.dataset.options ? JSON.parse(el.dataset.options) : undefined;
    mods[`../demos/${el.dataset.demoApp}/index.ts`]().then((m) => m.mount(el, options));
  }
</script>

<style>
  :global(:root:has(.demo-app)) {
    --sl-content-width: 64rem;
  }
  .demo-app {
    margin-top: 1rem;
  }
  .demo-source {
    margin-top: 0.75rem;
  }
  .demo-source summary {
    cursor: pointer;
    font: 600 14px var(--sans);
    width: fit-content;
  }
  .demo-source summary code {
    font-size: 13px;
  }
</style>
