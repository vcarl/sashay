---
// Without a key, no script is built and no note is shown.
const on = Boolean(import.meta.env.PUBLIC_POSTHOG_KEY);
---
{on && <p class="metrics-note">This site counts visits, clicks and demo use with PostHog, without cookies.</p>}
{
  on && (
    <script>
      import { startMetrics } from "../scripts/metrics.ts";

      startMetrics(
        import.meta.env.PUBLIC_POSTHOG_KEY,
        import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com",
      );
    </script>
  )
}
