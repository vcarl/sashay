---
import { version } from "../../../../packages/sashay/package.json";
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/landing.css";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const abs = (path: string) => new URL(`${base}${path}`, Astro.site).href;
const title = "Sashay: sliding panes for the web";
const description = "A sliding-panes layout for the web. Snaps, flings, bottom bars, deep stacks, and a layout that fits in a URL.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs("")} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={abs("")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs("share.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Three sliding panes: Sashay, Why panes?, and Hang it in a frame." />
    <meta property="og:video" content={abs("share.mp4")} />
    <meta property="og:video:type" content="video/mp4" />
    <meta property="og:video:width" content="1280" />
    <meta property="og:video:height" content="800" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <header class="wrap mast">
      <a class="brand" href={base}>sashay<small>@vcarl/sashay · {version} · MIT</small></a>
      <nav>
        <a href={`${base}guide/`}>Docs</a>
        <a href={`${base}themes/`}>Themes</a>
        <a href="https://github.com/vcarl/sashay">GitHub</a>
        <a href="https://www.npmjs.com/package/@vcarl/sashay">npm</a>
      </nav>
    </header>
    <slot />
    <footer class="wrap">
      <div><b>sashay</b> &nbsp;·&nbsp; a sash window is made of sliding panes.</div>
      <div>
        Built by Carl Vitullo · MIT ·
        <a href="https://github.com/vcarl/sashay">GitHub</a> ·
        <a href="https://www.npmjs.com/package/@vcarl/sashay">npm</a> ·
        <a href="https://github.com/vcarl/sashay/blob/main/packages/sashay/CHANGELOG.md">Changelog</a>
      </div>
    </footer>
  </body>
</html>
