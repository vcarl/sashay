---
import Landing from "../layouts/Landing.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<Landing>
  <main class="wrap">
    <section class="window" aria-label="Live demo">
      <div class="frame" id="hero">
        <div class="pane p-hello" data-sashay-pane="hello"><div class="in">
          <div>
            <div class="eyebrow">@vcarl/sashay — sliding panes for the web</div>
            <h1>Panes that <em>sashay.</em></h1>
            <p>A webOS-style layout. Drag an edge and it snaps to a fraction. Throw it and it flings. Panes slide over each other instead of squishing, and the whole arrangement fits in a URL.</p>
            <div class="cta"><a class="btn fill" href={`${base}guide/`}>Read the docs</a><a class="btn" href="#install">npm i @vcarl/sashay</a></div>
          </div>
          <div class="hint"><svg width="26" height="18" viewBox="0 0 26 18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 9h24M7 3 1 9l6 6M19 3l6 6-6 6"/></svg> <span class="wide">This headline is a pane. Grab the red edge to its right.</span><span class="narrow">This headline is a pane. On a phone the edges become tabs: tap one.</span></div>
        </div></div>

        <div class="pane p-why" data-sashay-pane="why"><div class="in">
          <div>
            <h2>Why panes?</h2>
            <ol>
              <li><div><b>Fractions, not pixels.</b> Dividers rest at ½, ⅓, ¼ … so layouts survive a window resize.</div></li>
              <li><div><b>Nothing ever squishes.</b> A squeezed pane keeps its width; the next one slides over it.</div></li>
              <li><div><b>Stacks go deep.</b> Drill a thousand levels; old panes fold into a spine.</div></li>
              <li><div><b>Zero dependencies.</b> Vanilla DOM controller, React wrapper optional.</div></li>
            </ol>
          </div>
        </div></div>

        <div class="pane p-install" data-sashay-pane="install" id="install"><div class="in">
          <div>
            <h2>Hang it in a frame.</h2>
<pre><span class="c">// npm i @vcarl/sashay</span>
<span class="k">import</span> {"{"} createSashay {"}"}
  <span class="k">from</span> <span class="s">"@vcarl/sashay"</span>;

createSashay(frame, {"{"}
  panes: [
    {"{"} id: <span class="s">"list"</span>,
      title: <span class="s">"List"</span>,
      focus: <span class="s">1/3</span> {"}"},
    {"{"} id: <span class="s">"detail"</span>,
      title: <span class="s">"Detail"</span>,
      focus: <span class="s">1/2</span> {"}"},
  ],
  onChange: saveToUrl,
{"}"});</pre>
            <div class="meta"><span>ESM only</span><span>0 deps</span><span>React ≥19 optional</span><span>MIT</span></div>
          </div>
        </div></div>
      </div>

      <div class="readout" id="readout">
        <span class="url"><span>?layout=</span><span class="code">58</span></span>
        <span class="say">That's the whole layout: one hex digit per divider. Drag an edge, throw it, or click one to open and close.</span>
        <button type="button">Reset</button>
      </div>
    </section>

    <section class="poster" aria-label="Features">
      <div class="cell c-3">
        <span class="num">01 / Snap</span>
        <h2>Snaps to simple fractions.</h2>
        <p>Dividers rest on fractions with a denominator up to six, so a layout saved on a laptop still makes sense on a monitor. The grid gets finer as the frame gets wider.</p>
        <a class="more" href={`${base}guide/#your-first-frame`}>Guide: Your first frame →</a>
        <div class="art ruler" aria-hidden="true"><i class="big" data-f="0" style="left:0"></i><i data-f="1/4" style="left:25%"></i><i data-f="1/3" style="left:33.33%"></i><i class="big" data-f="1/2" style="left:50%"></i><i data-f="2/3" style="left:66.67%"></i><i data-f="3/4" style="left:75%"></i><i class="big" data-f="1" style="left:100%"></i></div>
      </div>
      <div class="cell c-3 cobalt">
        <span class="num">02 / Fling</span>
        <h2>Throw it.</h2>
        <p>A quick throw carries the divider one or two snaps past where you let go. Release speed is read from the last 90&nbsp;ms, so a slow drag still lands exactly where you put it.</p>
        <a class="more" href={`${base}guide/#your-first-frame`}>Guide: Your first frame →</a>
        <div class="art mf" id="cell-fling">
          <div data-sashay-pane="a"><div class="line" style="width:70%"></div><div class="line" style="width:45%"></div></div>
          <div data-sashay-pane="b"><div class="line" style="width:60%"></div><div class="line" style="width:80%"></div><div class="line" style="width:40%"></div></div>
        </div>
      </div>
      <div class="cell c-2">
        <span class="num">03 / Drawers</span>
        <h2>Drawers in the frame.</h2>
        <p>Any edge can open a drawer: filters, settings, a table of contents. On a phone it becomes a sheet.</p>
        <a class="more" href={`${base}guide/#drawers`}>Guide: Drawers →</a>
        <div class="art mf" id="cell-drawer">
          <div data-sashay-pane="list"><div class="line" style="width:70%"></div><div class="line" style="width:50%"></div><div class="line" style="width:60%"></div></div>
          <div data-sashay-drawer="list" class="md"><label><input type="checkbox" checked /> Open</label><label><input type="checkbox" checked /> Mine</label><label><input type="checkbox" /> Archived</label></div>
        </div>
      </div>
      <div class="cell c-2 mint">
        <span class="num">04 / Spine</span>
        <h2>Deep stacks fold into a spine.</h2>
        <p>Drill down as far as you like. Panes that no longer fit fold into one slim spine with a count. Drag cost stays flat at a thousand deep.</p>
        <a class="more" href={`${base}guide/#navigation-stacks`}>Guide: Navigation stacks →</a>
        <div class="art">
          <div class="mf" id="cell-spine">
            <div data-sashay-pane="s1"><b>1</b><div class="line" style="width:80%"></div><div class="line" style="width:55%"></div></div>
            <div data-sashay-pane="s2"><b>2</b><div class="line" style="width:60%"></div><div class="line" style="width:85%"></div></div>
          </div>
          <div class="acts"><button type="button" data-act="add">Add pane</button><button type="button" data-act="back">Back</button></div>
        </div>
      </div>
      <div class="cell c-2 butter">
        <span class="num">05 / Persist</span>
        <h2>The layout is a word.</h2>
        <p>One hex digit per divider plus the drawer bits. Short enough for a query string, stable across list changes.</p>
        <a class="more" href={`${base}guide/#layout-in-the-url`}>Guide: Layout in the URL →</a>
        <div class="art">
          <div class="mf" id="cell-code">
            <div data-sashay-pane="x"><div class="line" style="width:70%"></div></div>
            <div data-sashay-pane="y"><div class="line" style="width:50%"></div></div>
            <div data-sashay-pane="z"><div class="line" style="width:60%"></div></div>
          </div>
          <input class="bigcode" aria-label="Layout code" spellcheck="false" autocomplete="off" value="58" />
        </div>
      </div>
    </section>

    <section class="seeit" aria-labelledby="seeit-h">
      <h2 id="seeit-h">See it work.</h2>
      <figure>
        <div class="demo-app" data-demo-app="finance"></div>
        <figcaption><b>A portfolio in three panes.</b> Pick a bar, then a transaction. Squeeze the chart and your bar stays put.</figcaption>
      </figure>
      <figure>
        <div class="demo-app" data-demo-app="house"></div>
        <figcaption><b>A house, all the way down.</b> Rooms, dressers, drawers, a tin box. The old levels fold into the spine.</figcaption>
      </figure>
      <a class="btn" href={`${base}demos/`}>Both demos, with source</a>
    </section>

    <section class="specs" aria-label="At a glance">
      <div><b>0</b><span>runtime dependencies</span></div>
      <div><b>&lt;2<em>ms</em></b><span>drag frame at 1,000 panes</span></div>
      <div><b>← →</b><span>keyboard on every edge, aria-valuenow</span></div>
      <div><b>1.0</b><span>vanilla + React ≥19 · MIT</span></div>
    </section>

    <section id="docs" aria-label="Docs preview">
      <div class="docs-head">
        <h2>The docs wear the same <span class="wonk">frame</span>.</h2>
        <p>Short pages, runnable examples, one sidebar painted like a sash stile. Starlight underneath; none of the Starlight look on top.</p>
      </div>
      <div class="docs" aria-hidden="true" inert>
        <aside class="side">
          <div class="brand">sashay</div>
          <a>Guide</a><a>Demos</a><a aria-current="page">Reference</a>
        </aside>
        <div class="main">
          <div class="bc">Reference</div>
          <h1><code>createSashay(frame, options)</code></h1>
          <p>Attaches to <code>frame</code>, finds one <code>[data-sashay-pane]</code> per pane, and creates every control itself: edges, the leaf × button, grips and the spine. Returns a handle.</p>
          <table><thead><tr><th>Option</th><th>Type</th><th>What it does</th></tr></thead><tbody>
            <tr><td><code>panes</code></td><td><code>PaneOptions[]</code></td><td>Left to right. May change at any time; diffed by <code>id</code>.</td></tr>
            <tr><td><code>layout</code></td><td><code>string</code></td><td>A saved code. Bad input falls back to <code>defaultLayout</code>.</td></tr>
            <tr><td><code>onChange</code></td><td><code>(code) ⇒ void</code></td><td>Fires on release, click or keypress. Never during a drag.</td></tr>
          </tbody></table>
<pre><span class="k">const</span> sash = createSashay(el, {"{"} panes, layout: params.get(<span class="s">"layout"</span>) {"}"});
sash.reveal(<span class="s">"detail"</span>);</pre>
        </div>
      </div>
    </section>
  </main>
</Landing>

<script>
  import "@vcarl/sashay/style.css";
  import { mountCells } from "../scripts/cells.ts";
  import { mountHero } from "../scripts/hero.ts";

  mountHero(document.getElementById("hero") as HTMLElement, document.getElementById("readout") as HTMLElement);
  mountCells(document.querySelector(".poster") as HTMLElement);
  import("../demos/browser.ts").then(({ browse }) => {
    browse(document.querySelector('[data-demo-app="finance"]') as HTMLElement, { compactBelow: "30rem" });
    browse(document.querySelector('[data-demo-app="house"]') as HTMLElement);
  });
</script>
