{
  "name": "@vcarl/sashay",
  "version": "1.0.0-alpha.0",
  "license": "MIT",
  "author": "Carl Vitullo",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vcarl/sashay.git",
    "directory": "packages/sashay"
  },
  "homepage": "https://vcarl.com/sashay/",
  "bugs": "https://github.com/vcarl/sashay/issues",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@vcarl/sashay/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "@vcarl/sashay/source": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./style.css": "./dist/style.css"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "bench": "vitest run --project bench",
    "build": "tsdown && cp src/sashay.css dist/style.css",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "9.6 kB"
    },
    {
      "path": "dist/react.js",
      "limit": "10.9 kB",
      "ignore": [
        "react",
        "react-dom"
      ]
    },
    {
      "path": "dist/style.css",
      "limit": "2.3 kB",
      "rolldown": false
    }
  ],
  "devDependencies": {
    "@size-limit/file": "^14.3.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.1",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
